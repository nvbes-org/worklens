{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local window: folder selection and explicit HTTPS link opening only.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/**" }] }
  ]
}
